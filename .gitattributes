# Normalize line endings to LF in the repo, check out as-is on all platforms
* text=auto eol=lf

# Force LF for Python and config files
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.zip binary
*.whl binary
